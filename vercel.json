{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/inquiry.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.montanacontracting.com"
        }
      ],
      "destination": "https://montanacontracting.com/:path*",
      "permanent": true
    },
    {
      "source": "/projects/haviland-court",
      "destination": "/projects/saugerties-residence/",
      "permanent": true
    },
    {
      "source": "/projects/haviland-court/",
      "destination": "/projects/saugerties-residence/",
      "permanent": true
    },
    {
      "source": "/projects/haviland-court/index.html",
      "destination": "/projects/saugerties-residence/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:dir(pre-construction|custom-homes|commercial|core-values|people|financing|privacy|projects)/index.html",
      "destination": "/:dir/",
      "permanent": true
    },
    {
      "source": "/projects/:slug([a-z0-9-]+)/index.html",
      "destination": "/projects/:slug/",
      "permanent": true
    },
    {
      "source": "/:dir(pre-construction|custom-homes|commercial|core-values|people|financing|privacy|projects)",
      "destination": "/:dir/",
      "permanent": true
    },
    {
      "source": "/projects/:slug([a-z0-9-]+)",
