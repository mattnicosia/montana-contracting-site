<style id="wp-custom-css">
html{
	margin-top:0 !important;
}
.social.color .fa-facebook, .social.color path {
    color: #0083be !important;
    fill: #0083be !important;
}
.footer .social a:last-child:before,.social a:last-child:before  {
    display: none;
}

/* Hide hardcoded "Commercial Projects" section on homepage (mixed residential/commercial tiles). Temporary patch pending theme template edit. */
.section-our-project {
    display: none;
}

/* === MODERN TYPOGRAPHY === Fraunces (headings) + Inter (body) via Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap');

body, p, li, a, span, div, input, textarea, button, select {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body {
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.005em;
}

h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif !important;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
    font-optical-sizing: auto;
}

h1, .h1 { font-weight: 500; }
h2, .h2 { font-weight: 500; }
h3, .h3 { font-weight: 500; }

/* Tighten and refine button/CTA type */
.btn, button, input[type="submit"], .navbar a {
    font-family: 'Inter', sans-serif !important;
    font-weight: 500;
    letter-spacing: 0.02em;
}


/* Hide empty hero CTA buttons (Who We Are / Contact Us removed) */
.hero-btn-group {
    display: none !important;
}


/* Remove grey gap below hero image */
.hero-slider .slick-slide > div { font-size: 0; line-height: 0; }
.hero-slider img.hidden-xs { display: block; vertical-align: bottom; width: 100%; height: 100%; object-fit: cover; }


/* Fix: prevent Joe Montana photo column from being too short,
 *    which causes the blue name box to cover his face on some
 *    computers due to font/zoom/DPI differences affecting text height */
.section-president .row.equal {
	    min-height: 552px;
}
}

/* Increase nav link font size by 1px (was 10.5px) */
.navbar-default .navbar-nav > li > a { font-size: 11.5px !important; }

/* Increase Montana logo size by 10% (was 95px max-width) */
.navbar-brand img, .navbar-brand .custom-logo, header .navbar-brand img { max-width: 104.5px !important; height: auto !important; }

/* Prevent Portfolio dropdown submenu from overflowing off the right edge of screen */
.sub-menu { left: auto !important; right: 0 !important; }
</style>
<style id="sccss">.nav-tabs, .tabs-mod div { display: none; }
nav.navbar.navbar-default { border-top: 0 !important; padding-top: 8px !important; padding-bottom: 8px !important; }
.navbar-number a[href^="tel:"] { display: none !important; }
.navbar-default .navbar-nav > li > a { letter-spacing: 0.04em !important; }
.navbar-default .navbar-nav > li.current-menu-item > a, .navbar-default .navbar-nav > li.current_page_item > a { color: #1a1a1a !important; background: transparent !important; border-bottom: 1px solid #1a1a1a !important; padding-bottom: 4px !important; }
.full-image-text .offer { display: none !important; }
.footer-copy .container p:nth-of-type(2) { display: none !important; }
footer address span:nth-of-type(2) { display: none !important; }
.footer-copy .container p:first-of-type { font-size: 0 !important; line-height: 0 !important; }
.footer-copy .container p:first-of-type::before { content: "\A9\A0 2026 Montana Contracting Corp."; font-size: 13px; line-height: 20.8px; color: rgb(102, 101, 101); font-family: Inter, sans-serif; }
.mc-hero__sub { letter-spacing: 0.2em !important; font-size: 11px !important; }
@media (max-width: 767px) {
  .full-image-text .slick-slide > div > div {
    background-image: none !important;
    height: auto !important;
    display: block !important;
  }
  .full-image-text .slick-slide img.visible-xs {
    width: 100%;
    height: auto;
    display: block !important;
  }
}

/* Fix duplicate/zoomed image on mobile in residential &amp; commercial sections */
@media (max-width: 767px) {
  .full-image-text .slick-slide img.visible-xs {
    width: 100% !important;
    aspect-ratio: 4 / 3 !important;
    object-fit: cover !important;
    object-position: center !important;
    height: auto !important;
    display: block !important;
  }
  .full-image-text .slick-slide > div > div {
    background-image: none !important;
    height: auto !important;
    display: block !important;
  }
  .full-image-text .slick-list,
  .full-image-text .slick-track,
  .full-image-text .slick-slide,
  .full-image-text .slick-slide > div {
    height: auto !important;
  }
}

/* Reduce header logo and nav size by 25% */
.navbar-brand img,
.navbar-brand .custom-logo,
header .navbar-brand img {
  max-width: 104.5 !important;
  height: auto !important;
}
.navbar-default .navbar-nav > li > a {
  font-size: 11.5px!important;
  letter-spacing: 0.42px !important;
}


.sub-menu li a {
